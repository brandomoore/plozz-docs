{
  "name": "plozz-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "check:content": "node tools/check.mjs --content-only",
    "test": "node --test tests/*.test.mjs",
    "source:plan": "node tools/source.mjs plan",
    "source:finalize": "node tools/source.mjs finalize",
    "agent:write": "node tools/run-agent.mjs write",
    "agent:review": "node tools/run-agent.mjs review",
    "deploy:upload": "wrangler versions upload --config wrangler.toml",
    "deploy:activate": "wrangler versions deploy --config wrangler.toml"
  },
  "dependencies": {
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "wrangler": "4.133.0"
  },
  "engines": {
    "node": ">=22"
  }
}
